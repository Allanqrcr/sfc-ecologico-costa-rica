    given-names: "Allan"
    affiliation: "Universidad Nacional, Costa Rica"
  - family-names: "Otoya Chavarría"
    given-names: "Marco"
    affiliation: "Universidad Nacional, Costa Rica"
license: MIT
keywords:
  - stock-flow consistent
  - macroeconomía ecológica
  - descarbonización
  - Costa Rica
  - transición energética
